APP_ENV=development
DB_PATH=./runtime/copilot.db
CHECKPOINT_PATH=./runtime/checkpoints.db
MEMORY_PATH=./runtime/memory.db
ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_API_KEY=
GROQ_API_KEY=
SEMANTIC_MODE=real
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
RAG_MODE=chroma
RAG_PATH=./runtime/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PII_MODE=presidio
OTEL_ENABLED=true
PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=transaction-dispute-copilot

# Local API authentication: replace these synthetic demo credentials before deployment.
API_TOKENS_JSON={"CHANGE_ME_ANALYST_TOKEN_1234567890":{"actor_id":"analyst:A-001","role":"analyst","team":"fraud-ops"},"CHANGE_ME_REVIEWER_TOKEN_1234567890":{"actor_id":"reviewer:R-001","role":"reviewer","team":"fraud-ops"}}
STREAMLIT_ACCESS_TOKEN=replace-with-a-random-local-ui-token-1234567890
STREAMLIT_ACTOR_ID=analyst:A-001
STREAMLIT_ROLE=analyst
OUTBOX_SINK=./runtime/outbox-deliveries.jsonl
HF_HOME=./runtime/hf_cache
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
EVAL_JUDGE_FALLBACK=1
GROQ_JUDGE_MODEL=
RAG_LLM_REWRITE=1

MCP_CALL_TIMEOUT_SECONDS=20
SEMANTIC_PROVIDER_TIMEOUT_SECONDS=30
MAX_PROVIDER_CALLS=8
MAX_CONTEXT_TOKENS=6000
SEMANTIC_MAX_WORKERS=4
OUTBOX_MAX_ATTEMPTS=5
MAX_RUN_SECONDS=120
MAX_GRAPH_STEPS=40
CLASSIFICATION_BUDGET=2
RAG_REWRITE_BUDGET=1
PROVIDER_MAX_ATTEMPTS=2
HIGH_VALUE_THRESHOLD=50000.00
